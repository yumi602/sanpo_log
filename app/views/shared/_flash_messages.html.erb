<% flash.each do |message_type, message| %>
  <div class="mb-3">
    <div class="<%= flash_class(message_type) %> w-full flex items-center justify-between">
      <span><%= message %></span>
      <button onclick="this.parentElement.parentElement.remove()" class="btn btn-sm btn-ghost">
        ✕
      </button>
    </div>
  </div>
<% end %>