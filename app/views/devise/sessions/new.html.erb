<div class="min-h-[calc(100vh-8rem)] flex items-center justify-center px-4 py-8 bg-base-200">
  <div class="card w-full max-w-md bg-base-100 shadow-xl">
    <div class="card-body">
      <h1 class="text-2xl font-bold text-center mb-6">ログイン</h1>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        <div class="form-control">
          <%= f.label :email, "メールアドレス", class: "label" %>
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                class: "input input-bordered w-full" %>
        </div>

        <div class="form-control">
          <%= f.label :password, "パスワード", class: "label" %>
          <%= f.password_field :password,
                autocomplete: "current-password",
                class: "input input-bordered w-full" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-control">
            <label class="label cursor-pointer justify-start gap-3">
              <%= f.check_box :remember_me, class: "checkbox checkbox-sm" %>
              <span class="label-text">ログイン状態を保持する</span>
            </label>
          </div>
        <% end %>

        <div class="pt-2">
          <%= f.submit "ログイン", class: "btn btn-primary w-full" %>
        </div>
      <% end %>

      <div class="divider my-2"></div>

      <div class="text-sm text-center space-y-2">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>