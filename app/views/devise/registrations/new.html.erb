<div class="min-h-[calc(100vh-8rem)] flex items-center justify-center px-4 py-8 bg-base-200">
  <div class="card w-full max-w-md bg-base-100 shadow-xl">
    <div class="card-body">
      <h1 class="text-2xl font-bold text-center mb-6">新規登録</h1>

      <%= render "devise/shared/error_messages", resource: resource %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        <div class="form-control">
          <%= f.label :email, "メールアドレス", class: "label" %>
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                class: "input input-bordered w-full" %>
        </div>

        <div class="form-control">
          <%= f.label :password, "パスワード", class: "label" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-base-content/70 mb-1">
              <%= @minimum_password_length %>文字以上で入力してください
            </p>
          <% end %>
          <%= f.password_field :password,
                autocomplete: "new-password",
                class: "input input-bordered w-full" %>
        </div>

        <div class="form-control">
          <%= f.label :password_confirmation, "パスワード（確認）", class: "label" %>
          <%= f.password_field :password_confirmation,
                autocomplete: "new-password",
                class: "input input-bordered w-full" %>
        </div>

        <div class="pt-2">
          <%= f.submit "新規登録", class: "btn btn-primary w-full" %>
        </div>
      <% end %>

      <div class="divider my-2"></div>

      <div class="text-sm text-center space-y-2">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>