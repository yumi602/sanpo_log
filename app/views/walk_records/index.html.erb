<div class="min-h-screen bg-base-200 px-4 py-6">
  <div class="mx-auto w-full max-w-md">

    <div class="mb-6">
      <% if @current_challenge.present? %>
        <div class="card bg-base-100 shadow-md border border-primary">
          <div class="card-body">
            <span class="badge badge-primary w-fit">進行中</span>

            <p class="mt-2 text-lg font-semibold">
              今の進捗: <%= @current_challenge.progress_count %> / 7
            </p>

            <div class="card-actions justify-end mt-2">
              <%= link_to "チャレンジ詳細を見る", challenge_path(@current_challenge), class: "btn btn-outline btn-primary btn-sm" %>
            </div>
          </div>
        </div>

      <% elsif @completed_challenge.present? %>
        <div class="card bg-base-100 shadow-md border border-success">
          <div class="card-body">
            <span class="badge badge-success w-fit">達成済み</span>

            <p class="mt-2 text-lg font-semibold">
              🎉 チャレンジ達成しました！
            </p>

            <div class="card-actions justify-end mt-2">
              <%= link_to "次のチャレンジを始める", new_challenge_path, class: "btn btn-success btn-sm" %>
            </div>
          </div>
        </div>

      <% else %>
        <div class="card bg-base-100 shadow-md">
          <div class="card-body">
            <p class="text-base-content/70">
              まだチャレンジを開始していません
            </p>

            <div class="card-actions justify-end mt-2">
              <%= link_to "桜の7日間チャレンジを始める", new_challenge_path, class: "btn btn-primary btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mb-4">
      <% if @completed_challenges_count.positive? %>
        <%= link_to "チャレンジ履歴を見る（#{@completed_challenges_count}件）", challenge_history_path, class: "btn btn-outline btn-primary btn-sm" %>
      <% else %>
        <%= link_to "チャレンジ履歴を見る", challenge_history_path, class: "btn btn-outline btn-sm" %>
      <% end %>
    </div>

    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold">散歩記録一覧</h1>
        <p class="mt-1 text-sm text-base-content/70">
          これまでの散歩記録を確認できます
        </p>
      </div>

      <%= link_to "新規投稿", new_walk_record_path, class: "btn btn-primary btn-sm" %>
    </div>

    <% if @walk_records.any? %>
      <div class="space-y-4">
        <% @walk_records.each do |walk_record| %>
          <div class="card bg-base-100 shadow-md">
            <div class="card-body">
              <div class="flex items-start justify-between gap-3">
                <h2 class="min-w-0 flex-1 text-lg font-bold leading-tight">
                  <%= link_to walk_record.title,
                      walk_record_path(walk_record),
                      class: "link link-hover break-words" %>
                </h2>
                <span class="badge badge-outline shrink-0"><%= walk_record.walked_on %></span>
              </div>

              <p class="text-sm text-base-content/70">
                気分：<%= walk_record.mood_label%>
              </p>

              <p class="whitespace-pre-wrap"><%= walk_record.body %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="card bg-base-100 shadow-md">
        <div class="card-body text-center">
          <p class="text-base-content/70">まだ散歩記録がありません</p>
          <%= link_to "最初の記録を投稿する", new_walk_record_path, class: "btn btn-primary mt-4" %>
        </div>
      </div>
    <% end %>
  </div>
</div>