<div class="max-w-2xl mx-auto p-6">
  <h1 class="text-2xl font-bold mb-4">チャレンジ詳細</h1>

  <div class="card bg-base-100 shadow-md mb-6">
    <div class="card-body">
      <h2 class="card-title"><%= @challenge.theme.name %>テーマ</h2>

      <p class="mb-2">
        進捗: <%= @challenge.progress_count %> / 7
      </p>

      <p class="mb-4">
        開始日: <%= @challenge.started_on %>
      </p>

      <div class="flex gap-2 text-2xl mb-4">
        <% 7.times do |i| %>
          <% if @challenge.completed? || i < @challenge.progress_count %>
            <span>🌸</span>
          <% else %>
            <span>□</span>
          <% end %>
        <% end %>
      </div>

      <% if @challenge.completed? %>
        <div class="mt-6 text-center">
          <p class="mb-2 text-lg font-semibold text-success">
            🌸 桜が満開になりました！
          </p>

          <%= image_tag "sakura.png", class: "mx-auto w-138 rounded-xl shadow-lg" %>
        </div>
      <% else %>
        <p>あと <%= 7 - @challenge.progress_count %> 回で完成です。</p>
      <% end %>

      <% unless @challenge.completed? %>
        <% puzzle_images = [
          "puzzle_1.png",
          "puzzle_2.png",
          "puzzle_3.png",
          "puzzle_4.png",
          "puzzle_5.png",
          "puzzle_6.png",
          "puzzle_7.png"
        ] %>

        <% achieved_count = @challenge.progress_count %>

        <div class="space-y-2 mt-4">
          <div class="grid grid-cols-4 gap-2">
            <% puzzle_images.first(4).each_with_index do |image_name, index| %>
              <div class="aspect-square overflow-hidden rounded border border-base-300 bg-base-200">
                <% if index < achieved_count %>
                  <%= image_tag image_name, class: "h-full w-full object-cover" %>
                <% else %>
                  <div class="flex h-full items-center justify-center text-3xl text-gray-400">
                    ?
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="grid grid-cols-3 gap-2">
            <% puzzle_images.last(3).each_with_index do |image_name, index| %>
              <div class="aspect-square overflow-hidden rounded border border-base-300 bg-base-200">
                <% if (index + 4) < achieved_count %>
                  <%= image_tag image_name, class: "h-full w-full object-cover" %>
                <% else %>
                  <div class="flex h-full items-center justify-center text-3xl text-gray-400">
                    ?
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="mt-6">
        <%= link_to "一覧へ戻る", walk_records_path, class: "btn btn-outline" %>
      </div>
    </div>
  </div>
</div>