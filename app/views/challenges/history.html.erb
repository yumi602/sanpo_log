<div class="min-h-screen bg-base-200 px-4 py-6">
  <div class="mx-auto w-full max-w-md">
    <div class="mb-6">
      <h1 class="text-2xl font-bold">チャレンジ履歴</h1>
      <p class="mt-1 text-sm text-base-content/70">
        過去に達成したチャレンジ一覧です
      </p>
    </div>

    <% if @completed_challenges.any? %>
      <div class="space-y-4">
        <% @completed_challenges.each do |challenge| %>
          <div class="card bg-base-100 shadow-md border border-success">
            <div class="card-body">
              <span class="badge badge-success w-fit">達成済み</span>

              <p class="mt-2 font-semibold">
                テーマ：<%= challenge.theme.name %>
              </p>

              <p class="text-sm text-base-content/70">
                開始日：<%= challenge.started_on %>
              </p>

              <p class="text-sm text-base-content/70">
                達成日：<%= challenge.completed_at.to_date %>
              </p>

              <p class="font-semibold">
                進捗：<%= challenge.progress_count %> / 7
              </p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="card bg-base-100 shadow-md">
        <div class="card-body text-center">
          <p class="text-base-content/70">まだ達成したチャレンジはありません</p>
        </div>
      </div>
    <% end %>

    <div class="mt-6">
      <%= link_to "一覧に戻る", walk_records_path, class: "btn btn-outline btn-sm" %>
    </div>
  </div>
</div>